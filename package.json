{
  "name": "skyrise-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "downloadEn": "pnpm exec locize download --project-id=4050ee26-7a52-476f-8ffa-0ceae5415c22 --language=en --ver=latest --clean=true --path=./src/@types/locales",
    "interface": "pnpm exec i18next-resources-for-ts interface -i ./src/@types/locales -o ./src/@types/resources.d.ts",
    "update-interface": "pnpm run downloadEn && pnpm run interface && rm -rf ./src/@types/locales"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "formik": "^2.4.6",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-locize-backend": "^7.0.4",
    "locize": "^4.0.14",
    "locize-lastused": "^4.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-router": "^7.7.0",
    "tailwindcss": "^4.1.11",
    "yup": "^1.6.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "i18next-resources-for-ts": "^1.6.0",
    "locize-cli": "^10.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
